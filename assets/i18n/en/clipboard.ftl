# SS Writer — copy, cut and paste (ssw-app ui).

# Shown when a picture is pasted into a document that has no file yet: pasted pictures are
# stored next to the document (spec §3.3), so the document needs a place first.
clipboard-save-first = Save this document first. Pasted pictures are stored in the attachment folder of the document's file.

# Format → Image: the file dialog that picks the pictures to insert.
clipboard-insert-image-title = Insert image
clipboard-filter-images = Images
