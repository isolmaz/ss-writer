# SS Writer — editor surface (English, source locale).

# Accessible name of the editing surface (UI Automation Document).
editor-access-name = Editor

# Gutter badge of the heading that has the caret: H1 … H6.
editor-heading-badge = H{ $level }

# Label of the pill shown after a folded heading.
editor-fold-pill = …

# Accessible descriptions of the block the caret is in.
editor-access-heading = Heading level { $level }
editor-access-paragraph = Paragraph
editor-access-blank-line = Blank line
editor-access-block = Block
