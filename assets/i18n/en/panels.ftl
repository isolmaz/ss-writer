# SS Writer — panels, context menus, file operations, help and banner flows (ssw-app ui).

# Inspector, Info tab: shown for a size or date that cannot be read.
panels-inspector-unavailable = —

# Line ending names in the Info tab.
panels-eol-lf = LF
panels-eol-crlf = CRLF
panels-eol-cr = CR

# Sidebar: name of the folder created by "New folder here" (numbered when taken).
panels-new-folder-name = New folder

# Sidebar: Delete asks before moving an item to the Recycle Bin.
panels-delete-title = Delete
panels-delete-message = Move { $name } to the Recycle Bin?

# Sidebar: why a rename or creation was refused.
panels-name-empty = The name cannot be empty.
panels-name-too-long = The name is too long.
panels-name-invalid-char = The name cannot contain { $char }.
panels-name-reserved = { $name } is a name Windows reserves.
panels-name-trailing = The name cannot end with a dot or a space.
panels-error-into-self = A folder cannot be moved or copied into itself.
